# Firebase Configuration
# Copy this file to .env.local and fill in your Firebase project values

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: enables the internal Gemini-powered chatbot
VITE_GOOGLE_AI_KEY=your-google-ai-key

# Google Drive bridge (Apps Script) — required to enable file uploads
# See apps-script/README.md for setup instructions
VITE_DRIVE_UPLOAD_URL=https://script.google.com/macros/s/AKfyc.../exec
VITE_DRIVE_UPLOAD_SECRET=long-random-shared-secret-matching-Code.gs
