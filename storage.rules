rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function userSignedIn() {
      return request.auth != null;
    }

    function userData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function canManageWorkspace() {
      return userSignedIn() && (
        (userData().equipos is list && 'manager' in userData().equipos) ||
        userData().rol == 'maestro' ||
        userData().rol == 'admin'
      );
    }

    match /files/{scope}/{fileName} {
      allow read: if userSignedIn();
      allow create: if userSignedIn();
      allow delete: if userSignedIn() && (
        canManageWorkspace() ||
        resource.metadata.uploadedBy == request.auth.uid
      );
    }
  }
}