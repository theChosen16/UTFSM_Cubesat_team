rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function: check if user has a specific role (supports both legacy 'rol' and new 'roles' array)
    //
    // Both helpers MUST read through `data.get(field, default)`. Dereferencing a missing field
    // directly (`userData.rol`, `userData.equipos`) raises an *evaluation error* in Firestore
    // rules rather than yielding a falsy value, and an erroring sub-expression poisons the whole
    // condition. Since AuthContext.signUp writes neither `roles` nor `equipos`, that was the
    // default state of every freshly-registered account: `hasRole()` errored for any user whose
    // `rol` did not match on the first comparison, and `hasTeam()` errored for anyone without an
    // `equipos` array. Because `canManageWorkspace()` evaluates `hasTeam('manager')` first, a
    // legitimate maestro/admin with no `equipos` field was denied every manager-gated write
    // (creating tasks, projects and events, enqueuing mail) — the authorization boundary was
    // failing on well-formed data instead of on the user's actual privileges.
    function hasRole(role) {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return userData != null && (
        userData.get('rol', '') == role ||
        (userData.get('roles', []) is list && role in userData.get('roles', []))
      );
    }

    function hasTeam(team) {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return userData != null &&
        userData.get('equipos', []) is list &&
        team in userData.get('equipos', []);
    }

    function canManageWorkspace() {
      return hasTeam('manager') || hasRole('maestro') || hasRole('admin');
    }

    // Server-side membership boundary for the private institutional workspace.
    //
    // The app is a *private* platform for the UTFSM CubeSat team, yet until now every
    // collaborative collection authorized on bare `request.auth != null`. The only
    // institutional-email restriction lived in the client (Register.tsx `validateEmail`),
    // which is trivially bypassed by calling Firebase Auth's signUp REST endpoint directly:
    // any attacker could mint an account with an arbitrary address and then read all tasks,
    // projects, files, posts, events and activity. The client check is UX, not a boundary.
    //
    // This helper enforces the boundary where it actually holds — in the rules. It only
    // inspects token claims (no get(), so it is cheap and adds no document reads) and reuses
    // the same fully ANCHORED pattern as the system_config gate, so look-alike domains such
    // as `eve@usm.cl.evil.com` are rejected (matches() is not implicitly anchored).
    //
    // The domain half of the boundary: the token claims an @usm.cl / @sansano.usm.cl address.
    // Fully ANCHORED, so look-alike domains such as `eve@usm.cl.evil.com` are rejected
    // (matches() is not implicitly anchored).
    function isInstitutionalDomain() {
      return request.auth != null &&
        request.auth.token.email is string &&
        request.auth.token.email.lower().matches('^[a-z0-9._%+-]+@(sansano[.])?usm[.]cl$');
    }

    // The ownership half. Until now the boundary was the domain claim ALONE, and that claim is
    // self-asserted: Firebase email/password sign-up neither verifies the address nor requires
    // the caller to receive anything at it. `identitytoolkit.googleapis.com/v1/accounts:signUp`
    // is a public endpoint keyed by the Web API key, which ships in the client bundle of a
    // public GitHub Pages site, so ANY anonymous person on the internet could mint a token for
    // an @usm.cl address they do not own — no @usm.cl mailbox, no relationship with the
    // university — and immediately read the entire private workspace: every project, task,
    // file record, calendar event, post, chat message and audit entry, plus the Drive bridge
    // shared secret in `system_config/keys`. The client-side domain check in Register.tsx never
    // entered the picture; the REST endpoint is reachable directly.
    //
    // Requiring `email_verified` restores the missing half: the caller must actually control an
    // institutional mailbox. AuthContext now sends the verification mail at registration and
    // provisions the profile document only once the address is verified.
    function hasVerifiedInstitutionalEmail() {
      return isInstitutionalDomain() &&
        request.auth.token.get('email_verified', false) == true;
    }

    // Server-side membership boundary for the private institutional workspace.
    //
    // A caller is a member if they hold a VERIFIED institutional address, or if the workspace
    // already carries a profile document for their uid. The second clause is a migration path,
    // not a hole: `/users/{uid}` can only be created by `hasVerifiedInstitutionalEmail()` (and
    // out-of-band by an operator), so an unverified newcomer cannot manufacture the very
    // document that would grandfather them — while members who registered before verification
    // was enforced keep working and can verify at their own pace. Once every account is
    // verified the `exists()` clause can be dropped outright.
    //
    // Ordered so the cheap token check short-circuits: the exists() document read only happens
    // for callers whose token is not verified.
    function isInstitutional() {
      return isInstitutionalDomain() && (
        request.auth.token.get('email_verified', false) == true ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid))
      );
    }

    // Truthfulness check for the display name attached to a notification.
    //
    // The Notifications page renders `senderName` verbatim as the identity of whoever sent the
    // item ("De: {senderName}" for alerts, and as the message header in the inbox). It was free
    // text: `senderId` was pinned to the caller's uid, but nothing tied the *name shown on screen*
    // to that uid, so any member could enqueue a `message` notification signed "Maestro USM
    // CubeSat" or the name of any teammate. The earlier hardening closed the `type: 'system'`
    // impersonation path but left this one, which produces the same effect in the UI — a message
    // that visibly comes from someone with authority — and is the natural setup for in-app
    // phishing ("sube el acta a este enlace", "confirma tu clave").
    //
    // The name is now bound to the caller's own profile. The accepted forms are exactly those the
    // shipped clients build: "nombre apellido" (Notifications.tsx), a bare "nombre", and the
    // email/uid fallbacks that TaskManagement.tsx uses when the profile has no name
    // (`user.nombre || user.email || user.id`).
    //
    // There is deliberately NO "profile has no name yet, allow anything" exemption. An earlier
    // revision of this rule carried one, to spare legacy accounts whose client backfills the
    // display name from their email address — and it handed the whole vulnerability straight
    // back: `nombre` is in the self-update allowlist and `Profile.tsx` saves the field verbatim
    // from a free-text input with no minimum length, so a member could simply blank their own
    // name and every `senderName` became forgeable again. An identity check must never be
    // satisfiable by a value its own subject controls. With the exemption gone a nameless profile
    // can still sign with its own email or uid — which impersonates nobody — and legacy documents
    // are healed at the source instead: AuthContext backfills the missing `nombre`/`apellido` onto
    // the profile on sign-in, so what the client shows and what the rules verify agree.
    function isTruthfulSenderName() {
      let claimed = request.resource.data.get('senderName', null);
      let sender = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let nombre = sender == null ? '' : sender.get('nombre', '');
      let apellido = sender == null ? '' : sender.get('apellido', '');
      return claimed == null || (
        claimed is string &&
        claimed.size() <= 120 && (
          claimed == nombre ||
          claimed == nombre + ' ' + apellido ||
          claimed == request.auth.token.email ||
          claimed == request.auth.uid
        )
      );
    }

    // Fields a user is allowed to update on their own profile.
    // Excludes 'rol'/'roles', 'isActive', 'email', 'createdAt' to prevent privilege escalation.
    //
    // The allowlist must stay in sync with what the app actually writes. Profile.tsx persists
    // 'bio', 'title', 'socialLinks' and 'portfolioImages', and OnboardingGuide.tsx persists
    // 'hasSeenOnboarding'; none of them were listed here, so every profile save from a regular
    // member was rejected by these rules (a functional regression of the previous hardening).
    // They are all non-privileged presentation fields, so they are added here — with size caps,
    // since 'portfolioImages' holds base64 data URLs and is a storage/egress-abuse vector.
    // 'fechaCumpleanos' is included so a member can set their own birthday without needing an
    // admin to run the bot's registrarCumpleanos action.
    function isAllowedSelfUpdate() {
      let allowed = [
        'nombre', 'apellido', 'career', 'year', 'genero', 'photoURL', 'questionnaire', 'equipos',
        'bio', 'title', 'socialLinks', 'portfolioImages', 'fechaCumpleanos', 'hasSeenOnboarding'
      ];
      // MUST be affectedKeys(), never changedKeys(). `changedKeys()` only reports keys present
      // in BOTH the before and after maps whose value differs; keys the write *adds* are
      // reported by `addedKeys()` and are invisible to it. Since a normal account has no `rol`
      // field at all, `changedKeys().hasOnly(allowed)` evaluated to true for a write that added
      // `rol: 'admin'` — letting any member grant themselves the admin role on their own
      // document (verified against the Firestore emulator). `affectedKeys()` is the union of
      // added + removed + changed and is the correct basis for a field allowlist.
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      // User cannot self-assign to the 'manager' team (grants workspace management rights)
      let noManagerSelfAssign = !changed.hasAny(['equipos']) ||
        !('manager' in request.resource.data.equipos);
      return changed.hasOnly(allowed) && noManagerSelfAssign && isBoundedProfile();
    }

    // Size caps for the self-editable free-text / media fields. The caps are generous relative
    // to the UI limits (PortfolioGallery caps at 8 images / ~900 KB total, Profile caps the
    // avatar data URL at ~720 KB) and exist so a member cannot script oversized profile
    // documents as a storage/egress-abuse vector.
    //
    // Applied on BOTH create and update: the caps only ever ran on update, so a member could
    // simply write the oversized document at registration time (profile creation is a client
    // write like any other) and never touch it again, sidestepping every bound below.
    function isBoundedProfile() {
      // 'nombre'/'apellido' are self-writable free text and had no ceiling at all, so they were
      // the one pair of unbounded strings left on the profile. The cap mirrors the 80-character
      // limit the client-side Zod schema already applies.
      return (!('nombre' in request.resource.data) ||
          (request.resource.data.nombre is string && request.resource.data.nombre.size() <= 80)) &&
        (!('apellido' in request.resource.data) ||
          (request.resource.data.apellido is string && request.resource.data.apellido.size() <= 80)) &&
        (!('bio' in request.resource.data) ||
          (request.resource.data.bio is string && request.resource.data.bio.size() <= 2000)) &&
        (!('title' in request.resource.data) ||
          (request.resource.data.title is string && request.resource.data.title.size() <= 120)) &&
        // 'photoURL' holds a base64 data URL (Profile.tsx embeds the avatar in the document),
        // so it is the single largest self-writable field and needs an explicit ceiling.
        (!('photoURL' in request.resource.data) ||
          (request.resource.data.photoURL is string &&
            request.resource.data.photoURL.size() <= 750000)) &&
        (!('portfolioImages' in request.resource.data) ||
          (request.resource.data.portfolioImages is list &&
            request.resource.data.portfolioImages.size() <= 8)) &&
        (!('equipos' in request.resource.data) ||
          (request.resource.data.equipos is list && request.resource.data.equipos.size() <= 2));
    }

    // Vertical privilege boundary between 'admin' and 'maestro'.
    //
    // The previous rule granted `hasRole('admin')` a blanket update on ANY user document, which
    // let any admin write `rol: 'maestro'` onto their own document and take over the workspace —
    // or strip/deactivate the real maestro. That contradicts both the documented policy ("Admin:
    // gestión de contenido y miembros *excepto maestro/admin*") and the client-side guard in
    // AuthContext.updateUserRole, which already restricts role assignment to the maestro. The
    // client guard is UX; this is the boundary. Roles are now maestro-only to grant, and admins
    // cannot touch a document that already holds an elevated role.
    function changesRoleFields() {
      // affectedKeys() so that *adding* a 'rol'/'roles' field to a document that lacks one is
      // detected as a role change (see the note in isAllowedSelfUpdate).
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['rol', 'roles']);
    }

    function targetHoldsElevatedRole() {
      return resource.data.get('rol', '') in ['maestro', 'admin'] ||
        (resource.data.get('roles', []) is list &&
          (('maestro' in resource.data.get('roles', [])) || ('admin' in resource.data.get('roles', []))));
    }

    match /users/{userId} {
      // A user may create ONLY their own profile and may NOT self-assign privileged
      // fields. Setting 'rol'/'roles' is rejected, 'isActive' can only be true, and the
      // 'manager' team (which grants workspace management) cannot be self-assigned.
      //
      // There is deliberately NO self-service maestro bootstrap any more. The previous rule
      // let any institutional caller create `/users/_bootstrap_lock` whenever that document
      // was absent (`userId == '_bootstrap_lock' && !exists(...)`) and then create their own
      // profile with `rol: 'maestro'`, because the elevated branch only required the lock to
      // name their uid — a lock they had just written themselves. AuthContext.signUp performs
      // exactly that sequence on every registration, so on any deployment where the lock is
      // missing (it postdates the workspace: every project provisioned before the lock was
      // introduced, or any workspace where a maestro deleted the document — `delete` on
      // /users/{userId} is maestro-allowed and matches '_bootstrap_lock' too) the NEXT person
      // to register silently became maestro of the whole workspace. That is a full takeover
      // reachable by anyone who can obtain an @usm.cl / @sansano.usm.cl address, including a
      // former member whose account still resolves.
      //
      // The first maestro is now provisioned out-of-band from the Firebase console (server-side
      // writes bypass these rules), which is a one-time operator action and cannot be replayed
      // by a client. See SECURITY.md → "Provisioning the first maestro".
      //
      // Creation requires a VERIFIED institutional address — deliberately stricter than
      // isInstitutional(), whose `exists(users/$(uid))` clause grandfathers accounts that
      // predate verification. If an unverified caller could create their own profile they
      // would grandfather themselves into the workspace in a single write, and the whole
      // boundary would collapse back to a self-asserted email claim.
      allow create: if hasVerifiedInstitutionalEmail() &&
        request.auth.uid == userId &&
        !request.resource.data.keys().hasAny(['rol', 'roles']) &&
        (!('isActive' in request.resource.data) || request.resource.data.isActive == true) &&
        (!('equipos' in request.resource.data) || !('manager' in request.resource.data.equipos)) &&
        isBoundedProfile();

      allow read: if isInstitutional() && (
        request.auth.uid == userId ||
        hasRole('maestro') ||
        hasRole('admin')
      );

      // Maestro can update any field on any user document (including roles).
      // Admin can manage regular members but may NOT grant/revoke roles and may not modify a
      // user who already holds an elevated role — that closes the admin -> maestro escalation.
      // Regular users can only update their own non-privileged fields.
      allow update: if isInstitutional() && (
        hasRole('maestro') ||
        (hasRole('admin') && !changesRoleFields() && !targetHoldsElevatedRole()) ||
        (request.auth.uid == userId && isAllowedSelfUpdate())
      );

      // Only maestro can delete user documents
      allow delete: if isInstitutional() &&
        hasRole('maestro');
    }

    match /notifications/{notificationId} {
      // Users can read their own notifications
      allow read: if isInstitutional() &&
        resource.data.recipientId == request.auth.uid;

      // Authenticated members can create notifications only if senderId matches their uid.
      // 'type' is constrained to the known NotificationType union and title/message are
      // size-capped to bound documents (storage/egress). The 'system' type is reserved for
      // workspace managers: it renders as an official platform alert, so allowing any member
      // to emit one is an in-app phishing vector. No legitimate member flow creates 'system'
      // notifications (see NotificationService: members only emit message / deadline_reminder
      // / deliverable_uploaded / task_assigned), so gating it behind canManageWorkspace()
      // closes the impersonation hole without breaking any client path.
      allow create: if isInstitutional() &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.recipientId is string &&
        request.resource.data.recipientId.size() > 0 &&
        request.resource.data.type in ['task_assigned', 'deliverable_uploaded', 'deadline_reminder', 'message', 'system'] &&
        (request.resource.data.type != 'system' || canManageWorkspace()) &&
        (!('title' in request.resource.data) ||
          (request.resource.data.title is string && request.resource.data.title.size() <= 300)) &&
        (!('message' in request.resource.data) ||
          (request.resource.data.message is string && request.resource.data.message.size() <= 3000)) &&
        // Se evalúa al final para que las comprobaciones baratas corten antes y el get() del
        // perfil solo ocurra en escrituras que ya pasaron el resto de las validaciones.
        isTruthfulSenderName();

      // Users can mark their own notifications as read, or delete them.
      //
      // The previous rule authorized an arbitrary `update` on any document whose *pre-image*
      // named the caller as recipient, and checked nothing about the post-image. Every control
      // on this collection — the `system`-type gate, `isTruthfulSenderName()`, the size caps,
      // the `senderId == uid` pin — is enforced on `create` only, so all of them were
      // bypassable in two writes:
      //
      //   1. create a perfectly legitimate `message` notification addressed to YOURSELF
      //      (passes every create check, since you are both sender and recipient), then
      //   2. update it, rewriting `recipientId` to the victim, `type` to `system`, `senderName`
      //      to "Maestro USM CubeSat" and title/message to whatever you like.
      //
      // The update rule only looked at the old recipientId, so step 2 was allowed — and the
      // read rule keys on the *current* recipientId, so the forged document lands in the
      // victim's inbox and renders as an official platform alert signed by someone with
      // authority. That is exactly the in-app phishing the create-side gates exist to prevent,
      // reached through the back door.
      //
      // An update is now confined to what the client actually performs
      // (`NotificationService.markAsRead` writes `{ read: true }` and nothing else): the
      // recipient must match on BOTH sides of the write, and `read` is the only field a write
      // may touch. Everything identity-bearing is therefore immutable after creation.
      allow update: if isInstitutional() &&
        resource.data.recipientId == request.auth.uid &&
        request.resource.data.recipientId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
        request.resource.data.read is bool;

      allow delete: if isInstitutional() &&
        resource.data.recipientId == request.auth.uid;
    }

    match /projects/{projectId} {
      // Institutional members can read projects (private team tool — the boundary is enforced
      // here, not only in the client). Managers create/update; deletion is maestro-only.
      //
      // Free-text fields are size-capped like every other member-writable collection.
      // `manager` is a self-service TEAM (any admin can grant it), not a vetted role, so the
      // manager write surface gets the same storage/egress bounds as the member one — projects
      // were the last manager-writable documents with no ceiling at all.
      allow read: if isInstitutional();
      allow create, update: if isInstitutional() && canManageWorkspace() &&
        (!('nombre' in request.resource.data) ||
          (request.resource.data.nombre is string && request.resource.data.nombre.size() <= 200)) &&
        (!('descripcion' in request.resource.data) ||
          (request.resource.data.descripcion is string &&
            request.resource.data.descripcion.size() <= 20000));
      allow delete: if isInstitutional() &&
        hasRole('maestro');
    }

    match /tasks/{taskId} {
      // Institutional members can read tasks (private team tool). Managers create;
      // assignees may update a restricted field set (guarded below); deletion is maestro-only.
      allow read: if isInstitutional();
      allow create: if isInstitutional() && canManageWorkspace();
      allow update: if isInstitutional() && (
        canManageWorkspace() ||
        (
          resource.data.asignadoA is list &&
          request.auth.uid in resource.data.asignadoA &&
          // affectedKeys(), not changedKeys(): otherwise an assignee could ADD any field the
          // task does not already carry (e.g. 'puntajeImportancia', 'asignadoA', 'equipo')
          // because newly added keys are absent from changedKeys().
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'estado',
            'progressUpdates',
            'fechaInicioReal',
            'fechaFinReal',
            'tiempoInvertido',
            'deliverables',
            'attachmentIds',
            'completedBy',
            'completedAt',
            'scoreAwarded'
          ]) &&
          // Cotas de forma y tamaño para la ruta del asignado. La lista blanca de campos dice
          // QUÉ puede tocar, pero no CUÁNTO: `progressUpdates`, `deliverables` y
          // `attachmentIds` son arreglos que el cliente hace crecer append-only, de modo que un
          // asignado podía inflar el documento de la tarea hasta el tope de 1 MiB de Firestore
          // (y repetirlo en cada tarea asignada) como vector de abuso de almacenamiento/egress,
          // igual que ya se acota en `posts`, `comments`, `files` y perfiles. `estado` además se
          // restringe al enum TaskStatus: era un string libre, así que un asignado podía dejar
          // la tarea en un estado inexistente que ninguna vista sabe filtrar.
          (!('estado' in request.resource.data) ||
            request.resource.data.estado in ['pendiente', 'en_progreso', 'completado']) &&
          (!('progressUpdates' in request.resource.data) ||
            (request.resource.data.progressUpdates is list &&
              request.resource.data.progressUpdates.size() <= 200)) &&
          (!('deliverables' in request.resource.data) ||
            (request.resource.data.deliverables is list &&
              request.resource.data.deliverables.size() <= 50)) &&
          (!('attachmentIds' in request.resource.data) ||
            (request.resource.data.attachmentIds is list &&
              request.resource.data.attachmentIds.size() <= 100)) &&
          // Anti-fraude de ranking (1/2): un asignado no puede auto-otorgarse un score arbitrario.
          // Siempre que scoreAwarded esté presente en el documento entrante, debe igualar el
          // puntaje de importancia fijado por un manager. Se compara contra get(...,0) para que
          // una tarea legada SIN puntajeImportancia solo admita scoreAwarded == 0 (antes esta
          // ausencia era una compuerta de escape que permitía cualquier score arbitrario). Si
          // scoreAwarded se omite (al revertir la tarea) no se verifica.
          (
            !request.resource.data.keys().hasAll(['scoreAwarded']) ||
            request.resource.data.scoreAwarded == resource.data.get('puntajeImportancia', 0)
          ) &&
          // Anti-fraude de ranking (2/2): un asignado solo puede atribuirse a SÍ MISMO la
          // finalización (y por ende el score). No puede acreditar la tarea a un tercero. Se
          // permite conservar un completedBy previo (idempotencia) y, al revertir, el campo se
          // elimina por lo que no aparece en keys() y la verificación se omite.
          (
            !request.resource.data.keys().hasAll(['completedBy']) ||
            request.resource.data.completedBy == request.auth.uid ||
            request.resource.data.completedBy == resource.data.get('completedBy', '')
          )
        )
      );
      allow delete: if isInstitutional() &&
        hasRole('maestro');
    }

    match /activity_log/{entryId} {
      // Institutional members can read activity logs for performance rankings.
      // Entry creation is restricted to the authenticated user's own entries.
      //
      // The activity log is the platform's *immutable audit trail* ("registro inmutable de
      // acciones de usuario"), so beyond the userId gate the entry SHAPE is constrained to
      // stop forging. Previously `type` was any string: a member could write audit entries of
      // arbitrary types for themselves (e.g. a fake 'task_completed'), polluting the shared
      // performance feed / audit trail rendered on the Dashboard and Members pages. We now
      // allowlist `type` to exactly the ActivityLogType values the app actually emits — the
      // documented union plus the two admin-action types cast at the call site
      // (`event_created`, `project_synced`) — mirroring the notifications allowlist hardening.
      // Free-text/id fields are size-capped to bound storage/egress abuse. There is
      // intentionally no update/delete rule, keeping the log strictly append-only.
      allow read: if isInstitutional();
      allow create: if isInstitutional() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.type in [
          'task_created', 'task_status_changed', 'task_progress_logged', 'task_completed',
          'deliverable_uploaded', 'deliverable_status_changed', 'event_created', 'project_synced'
        ] &&
        request.resource.data.description is string &&
        request.resource.data.description.size() <= 2000 &&
        (!('relatedId' in request.resource.data) ||
          (request.resource.data.relatedId is string && request.resource.data.relatedId.size() <= 300));
    }

    match /files/{fileId} {
      // File metadata for the Drive-backed repository. The uploader must be the caller.
      // The actual bytes live in Google Drive (not Firestore), so in the legitimate flow
      // these fields only ever hold a short name, ids and Drive URLs. They are size-capped
      // so a member cannot write oversized metadata documents as a storage/egress-abuse
      // vector; the caps are generous (Drive names are <=255, ids/URLs are short) and so do
      // not affect any real upload written by FileService.
      allow read: if isInstitutional();
      allow create: if isInstitutional() &&
        request.resource.data.uploadedBy == request.auth.uid &&
        (!('name' in request.resource.data) ||
          (request.resource.data.name is string && request.resource.data.name.size() <= 512)) &&
        (!('viewURL' in request.resource.data) ||
          (request.resource.data.viewURL is string && request.resource.data.viewURL.size() <= 2048)) &&
        (!('downloadURL' in request.resource.data) ||
          (request.resource.data.downloadURL is string && request.resource.data.downloadURL.size() <= 2048)) &&
        (!('driveFileId' in request.resource.data) ||
          (request.resource.data.driveFileId is string && request.resource.data.driveFileId.size() <= 256));
      allow delete: if isInstitutional() && (
        resource.data.uploadedBy == request.auth.uid ||
        canManageWorkspace()
      );
    }

    match /member_scores/{scoreId} {
      // Users can read their own score; workspace managers, admins, and maestros can read all.
      allow read: if isInstitutional() &&
        (resource.data.userId == request.auth.uid || canManageWorkspace());
      allow create, update, delete: if isInstitutional() && canManageWorkspace();
    }

    match /events/{eventId} {
      // Institutional members can read calendar events.
      // Creation, updates and deletions are restricted to workspace managers, admins, and maestros.
      // Free-text fields are size-capped: events are also created programmatically by the
      // assistant (AdminActionsService.crearEvento / auditarActaDrive) from model output, so the
      // rules bound what a manipulated model turn can persist per document.
      //
      // The date fields are bounded too, and not only for storage reasons. `fechaInicio` is
      // written verbatim by `AdminActionsService.auditarActaDrive` from text the model derived
      // from an uploaded minute, and it is later interpolated into the weekly digest e-mail
      // sent to every member. Keeping it to a short, plausible date string stops an event from
      // carrying a payload-sized value into that template at all (the template also escapes
      // it now — see EmailNotificationService.formatDate).
      allow read: if isInstitutional();
      allow create, update: if isInstitutional() && canManageWorkspace() &&
        (!('titulo' in request.resource.data) ||
          (request.resource.data.titulo is string && request.resource.data.titulo.size() <= 300)) &&
        (!('descripcion' in request.resource.data) ||
          (request.resource.data.descripcion is string && request.resource.data.descripcion.size() <= 5000)) &&
        (!('fechaInicio' in request.resource.data) ||
          (request.resource.data.fechaInicio is string &&
            request.resource.data.fechaInicio.size() <= 64)) &&
        (!('fechaFin' in request.resource.data) ||
          (request.resource.data.fechaFin is string &&
            request.resource.data.fechaFin.size() <= 64));
      allow delete: if isInstitutional() && canManageWorkspace();
    }

    match /mail/{mailId} {
      // Documents in /mail are consumed by the Firebase "Trigger Email" extension, which sends
      // whatever it finds from the project's configured SMTP identity. Gating creation on
      // canManageWorkspace() stops *members* from spamming, but it still left the extension as
      // an open relay for anyone holding that privilege — note that `manager` is a self-service
      // TEAM, granted by any admin via updateUserTeams, not a vetted role. A manager could
      // enqueue arbitrary HTML to arbitrary external recipients and it would leave as
      // authenticated mail from the team's address (phishing with perfect provenance, plus
      // reputation damage to the sending domain).
      //
      // The legitimate producer (EmailNotificationService.sendWeeklyDigest) only ever mails
      // registered members, whose addresses are institutional by construction, so the recipient
      // is constrained to the same anchored institutional pattern used everywhere else and the
      // payload is size-capped.
      //
      // Constraining `to` alone did NOT close the relay. The Trigger Email extension resolves
      // its recipients from a whole family of fields — `cc`, `bcc`, `toUids`, `ccUids`,
      // `bccUids` — and also honours `from`, `replyTo`, `headers`, `template` and
      // `message.attachments` (whose `path`/`href` form makes the extension fetch an arbitrary
      // URL and attach the response). None of those were mentioned by the rule, so they were
      // simply unconstrained: a `manager` could enqueue a document with an institutional `to`
      // and `bcc: ["victim@example.com"]`, and the extension would deliver attacker-authored
      // HTML to any address on the internet, signed by the team's own SMTP identity and
      // passing its SPF/DKIM — the exact open-relay/phishing outcome the recipient check was
      // added to prevent, plus reputation damage to the sending domain.
      //
      // The rule therefore pins the DOCUMENT SHAPE to exactly what the digest writes rather
      // than blocklisting fields one at a time: any key the extension might interpret that the
      // legitimate producer does not write is rejected outright, and new extension features
      // cannot silently reopen the hole.
      allow create: if isInstitutional() && canManageWorkspace() &&
        request.resource.data.keys().hasOnly(['to', 'message', 'createdAt']) &&
        request.resource.data.to is string &&
        request.resource.data.to.lower().matches('^[a-z0-9._%+-]+@(sansano[.])?usm[.]cl$') &&
        request.resource.data.message is map &&
        request.resource.data.message.keys().hasOnly(['subject', 'html', 'text']) &&
        (!('subject' in request.resource.data.message) ||
          (request.resource.data.message.subject is string &&
            request.resource.data.message.subject.size() <= 300)) &&
        (!('html' in request.resource.data.message) ||
          (request.resource.data.message.html is string &&
            request.resource.data.message.html.size() <= 200000)) &&
        (!('text' in request.resource.data.message) ||
          (request.resource.data.message.text is string &&
            request.resource.data.message.text.size() <= 200000));
    }

    match /mail_digests/{digestId} {
      // Each digest log embeds the full 'recipients' list — every active member's email address.
      // Reading it is a manager-only operation in the app (the WeeklyDigestWidget is rendered
      // behind canManageWorkspace, and the bot's obtenerEstadoNoticiario is admin-only), so the
      // rule is narrowed to match instead of exposing the whole team roster to every member.
      allow read: if isInstitutional() && canManageWorkspace();
      allow create: if isInstitutional() && canManageWorkspace();
    }

    match /system_config/{configId} {
      // system_config/keys holds the Drive shared secret, so the institutional-email gate must
      // be airtight. Firestore's matches() is NOT implicitly anchored, so an unanchored pattern
      // like '.*@(sansano[.])?usm[.]cl' also accepts attacker-controlled domains such as
      // 'eve@usm.cl.evil.com' (the regex matches a substring), letting an external user read the
      // secret. Anchor with ^...$ and restrict the local part so only true @usm.cl /
      // @sansano.usm.cl addresses pass. The email claim is also guarded as a string.
      //
      // La ESCRITURA es exclusiva del maestro. Este documento no guarda solo un secreto: guarda
      // `driveUploadUrl`, el endpoint al que cada navegador del equipo envía el **ID token de
      // Firebase del usuario** junto con los bytes de los archivos y el historial completo del
      // chat (FileService.callBridge y BotService.sendProxyMessage adjuntan `idToken` en cada
      // llamada). Quien pueda reescribir ese campo lo apunta a un despliegue de Apps Script
      // propio —que la CSP admite, porque vive en el mismo `script.google.com`— y cosecha
      // credenciales efímeras válidas de TODO el equipo, maestro incluido, con las que suplantar
      // a cualquiera frente a Firestore. Dárselo a `admin` contradice de plano la frontera que
      // este mismo archivo levanta en /users, donde un admin no puede tocar a un usuario con rol
      // elevado precisamente para que no pueda escalar a maestro: `system_config` era la puerta
      // trasera a esa misma escalada. El cliente ancla además el host del bridge
      // (SecretsService.isTrustedBridgeUrl) como segunda línea de defensa.
      allow read: if isInstitutional();
      allow write: if isInstitutional() && hasRole('maestro');
    }

    match /posts/{postId} {
      allow read: if isInstitutional();
      // 'imageUrls' holds base64 data URLs (PostCreator embeds the picture in the document
      // itself, there is no Storage bucket), so it — not 'content' — is what actually drives
      // the document size. Capping only the text left the real storage/egress vector open, so
      // the array length is bounded on create and update alike.
      allow create: if isInstitutional() &&
        request.resource.data.authorId == request.auth.uid &&
        (!('content' in request.resource.data) ||
          (request.resource.data.content is string && request.resource.data.content.size() <= 10000)) &&
        (!('imageUrls' in request.resource.data) ||
          (request.resource.data.imageUrls is list && request.resource.data.imageUrls.size() <= 4));
      // The author can edit their own post. Any other authenticated user may ONLY toggle their
      // own like: the previous rule let anyone overwrite likedBy/likesCount with arbitrary
      // values (wipe others' likes, set an arbitrary count). We now require that the only change
      // to likedBy is the caller adding or removing their OWN uid (symmetric difference == {uid})
      // and that likesCount stays consistent with the array length.
      // A content size cap is also enforced on update (not just create) so an author cannot
      // grow their own post unboundedly to abuse storage/egress.
      // 'authorId' is immutable on update: without this an author could re-attribute their own
      // post to another member, planting content under a colleague's name in the shared feed.
      allow update: if isInstitutional() &&
        request.resource.data.get('authorId', '') == resource.data.get('authorId', '') &&
        (!('content' in request.resource.data) ||
          (request.resource.data.content is string && request.resource.data.content.size() <= 10000)) &&
        (!('imageUrls' in request.resource.data) ||
          (request.resource.data.imageUrls is list && request.resource.data.imageUrls.size() <= 4)) && (
        resource.data.authorId == request.auth.uid ||
        (
          // affectedKeys(), not changedKeys(): a post created without a 'likedBy'/'likesCount'
          // field would otherwise let a non-author add arbitrary new fields to someone else's
          // post under the guise of a like toggle.
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likesCount']) &&
          request.resource.data.likedBy is list &&
          request.resource.data.likesCount == request.resource.data.likedBy.size() &&
          resource.data.get('likedBy', []).toSet().difference(request.resource.data.likedBy.toSet())
            .union(request.resource.data.likedBy.toSet().difference(resource.data.get('likedBy', []).toSet()))
            == [request.auth.uid].toSet()
        )
      );
      allow delete: if isInstitutional() && (
        resource.data.authorId == request.auth.uid || hasRole('maestro') || hasRole('admin')
      );
    }

    match /comments/{commentId} {
      allow read: if isInstitutional();
      allow create: if isInstitutional() &&
        request.resource.data.authorId == request.auth.uid &&
        (!('content' in request.resource.data) ||
          (request.resource.data.content is string && request.resource.data.content.size() <= 5000));
      allow delete: if isInstitutional() && (
        resource.data.authorId == request.auth.uid || hasRole('maestro') || hasRole('admin')
      );
      // Update keeps the same content size cap as create to bound storage/egress abuse, and
      // pins 'authorId' so a comment can never be re-attributed to another member.
      allow update: if isInstitutional() &&
        (resource.data.authorId == request.auth.uid || hasRole('maestro') || hasRole('admin')) &&
        request.resource.data.get('authorId', '') == resource.data.get('authorId', '') &&
        (!('content' in request.resource.data) ||
          (request.resource.data.content is string && request.resource.data.content.size() <= 5000));
    }

    match /project_messages/{messageId} {
      allow read: if isInstitutional();
      // Like posts, 'fileUrls' carries base64 data URLs inlined by ProjectChat, so the array
      // length is bounded alongside the text.
      allow create: if isInstitutional() &&
        request.resource.data.senderId == request.auth.uid &&
        (!('content' in request.resource.data) ||
          (request.resource.data.content is string && request.resource.data.content.size() <= 5000)) &&
        (!('fileUrls' in request.resource.data) ||
          (request.resource.data.fileUrls is list && request.resource.data.fileUrls.size() <= 4));
      allow delete: if isInstitutional() && (
        resource.data.senderId == request.auth.uid || hasRole('maestro') || hasRole('admin')
      );
      // Update keeps the same content size cap as create to bound storage/egress abuse, and
      // pins 'senderId' so a message can never be re-attributed to another member.
      allow update: if isInstitutional() &&
        (resource.data.senderId == request.auth.uid || hasRole('maestro') || hasRole('admin')) &&
        request.resource.data.get('senderId', '') == resource.data.get('senderId', '') &&
        (!('content' in request.resource.data) ||
          (request.resource.data.content is string && request.resource.data.content.size() <= 5000)) &&
        (!('fileUrls' in request.resource.data) ||
          (request.resource.data.fileUrls is list && request.resource.data.fileUrls.size() <= 4));
    }
  }
}
