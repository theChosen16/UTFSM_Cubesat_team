rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function: check if user has a specific role (supports both legacy 'rol' and new 'roles' array)
    function hasRole(role) {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return userData != null && (userData.rol == role || (userData.roles is list && role in userData.roles));
    }

    function hasTeam(team) {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return userData != null && userData.equipos is list && team in userData.equipos;
    }

    function canManageWorkspace() {
      return hasTeam('manager') || hasRole('maestro') || hasRole('admin');
    }

    // Server-side membership boundary for the private institutional workspace.
    //
    // The app is a *private* platform for the UTFSM CubeSat team, yet until now every
    // collaborative collection authorized on bare `request.auth != null`. The only
    // institutional-email restriction lived in the client (Register.tsx `validateEmail`),
    // which is trivially bypassed by calling Firebase Auth's signUp REST endpoint directly:
    // any attacker could mint an account with an arbitrary address and then read all tasks,
    // projects, files, posts, events and activity. The client check is UX, not a boundary.
    //
    // This helper enforces the boundary where it actually holds — in the rules. It only
    // inspects token claims (no get(), so it is cheap and adds no document reads) and reuses
    // the same fully ANCHORED pattern as the system_config gate, so look-alike domains such
    // as `eve@usm.cl.evil.com` are rejected (matches() is not implicitly anchored).
    //
    // Note: this restricts the domain but intentionally does NOT require email_verified,
    // to avoid locking out existing email/password members who have not verified. Requiring
    // verified institutional emails end-to-end (as the Apps Script bridge already does) is
    // the recommended hardening once an in-app verification flow exists.
    function isInstitutional() {
      return request.auth != null &&
        request.auth.token.email is string &&
        request.auth.token.email.lower().matches('^[a-z0-9._%+-]+@(sansano[.])?usm[.]cl$');
    }

    // Fields a user is allowed to update on their own profile.
    // Excludes 'rol', 'isActive', 'email', 'createdAt' to prevent privilege escalation.
    function isAllowedSelfUpdate() {
      let allowed = ['nombre', 'apellido', 'career', 'year', 'genero', 'photoURL', 'questionnaire', 'equipos'];
      let changed = request.resource.data.diff(resource.data).changedKeys();
      // User cannot self-assign to the 'manager' team (grants workspace management rights)
      let noManagerSelfAssign = !changed.hasAny(['equipos']) ||
        !('manager' in request.resource.data.equipos);
      return changed.hasOnly(allowed) && noManagerSelfAssign;
    }

    match /users/{userId} {
      // A user may create ONLY their own profile and may NOT self-assign privileged
      // fields. Setting 'rol'/'roles' is rejected, 'isActive' can only be true, and the
      // 'manager' team (which grants workspace management) cannot be self-assigned.
      // The single exception is the genuine first registrant, who is allowed to bootstrap
      // as 'maestro' — but only if they are the uid recorded in the bootstrap lock that
      // the signup transaction created moments earlier. This closes the privilege-
      // escalation hole where any authenticated user could create their own doc as maestro.
      allow create: if request.auth != null && (
        (request.auth.uid == userId && (
          (
            !request.resource.data.keys().hasAny(['rol', 'roles']) &&
            (!('isActive' in request.resource.data) || request.resource.data.isActive == true) &&
            (!('equipos' in request.resource.data) || !('manager' in request.resource.data.equipos))
          ) ||
          (
            exists(/databases/$(database)/documents/users/_bootstrap_lock) &&
            get(/databases/$(database)/documents/users/_bootstrap_lock).data.maestroUid == request.auth.uid &&
            request.resource.data.rol == 'maestro' &&
            (!('equipos' in request.resource.data) || !('manager' in request.resource.data.equipos))
          )
        )) ||
        (userId == '_bootstrap_lock' && !exists(/databases/$(database)/documents/users/_bootstrap_lock))
      );

      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        userId == '_bootstrap_lock' ||
        hasRole('maestro') ||
        hasRole('admin')
      );

      // Maestro/admin can update any field on any user document.
      // Regular users can only update their own non-privileged fields.
      allow update: if request.auth != null && (
        hasRole('maestro') ||
        hasRole('admin') ||
        (request.auth.uid == userId && isAllowedSelfUpdate())
      );

      // Only maestro can delete user documents
      allow delete: if request.auth != null &&
        hasRole('maestro');
    }

    match /notifications/{notificationId} {
      // Users can read their own notifications
      allow read: if request.auth != null &&
        resource.data.recipientId == request.auth.uid;

      // Authenticated members can create notifications only if senderId matches their uid.
      // 'type' is constrained to the known NotificationType union and title/message are
      // size-capped to bound documents (storage/egress). The 'system' type is reserved for
      // workspace managers: it renders as an official platform alert, so allowing any member
      // to emit one is an in-app phishing vector. No legitimate member flow creates 'system'
      // notifications (see NotificationService: members only emit message / deadline_reminder
      // / deliverable_uploaded / task_assigned), so gating it behind canManageWorkspace()
      // closes the impersonation hole without breaking any client path.
      allow create: if isInstitutional() &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.recipientId is string &&
        request.resource.data.recipientId.size() > 0 &&
        request.resource.data.type in ['task_assigned', 'deliverable_uploaded', 'deadline_reminder', 'message', 'system'] &&
        (request.resource.data.type != 'system' || canManageWorkspace()) &&
        (!('title' in request.resource.data) ||
          (request.resource.data.title is string && request.resource.data.title.size() <= 300)) &&
        (!('message' in request.resource.data) ||
          (request.resource.data.message is string && request.resource.data.message.size() <= 3000));

      // Users can update or delete their own notifications (e.g., mark as read / dismiss)
      allow update, delete: if request.auth != null &&
        resource.data.recipientId == request.auth.uid;
    }

    match /projects/{projectId} {
      // Institutional members can read projects (private team tool — the boundary is enforced
      // here, not only in the client). Managers create/update; deletion is maestro-only.
      allow read: if isInstitutional();
      allow create, update: if request.auth != null && canManageWorkspace();
      allow delete: if request.auth != null &&
        hasRole('maestro');
    }

    match /tasks/{taskId} {
      // Institutional members can read tasks (private team tool). Managers create;
      // assignees may update a restricted field set (guarded below); deletion is maestro-only.
      allow read: if isInstitutional();
      allow create: if request.auth != null && canManageWorkspace();
      allow update: if request.auth != null && (
        canManageWorkspace() ||
        (
          resource.data.asignadoA is list &&
          request.auth.uid in resource.data.asignadoA &&
          request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'estado',
            'progressUpdates',
            'fechaInicioReal',
            'fechaFinReal',
            'tiempoInvertido',
            'deliverables',
            'attachmentIds',
            'completedBy',
            'completedAt',
            'scoreAwarded'
          ]) &&
          // Anti-fraude de ranking (1/2): un asignado no puede auto-otorgarse un score arbitrario.
          // Siempre que scoreAwarded esté presente en el documento entrante, debe igualar el
          // puntaje de importancia fijado por un manager. Se compara contra get(...,0) para que
          // una tarea legada SIN puntajeImportancia solo admita scoreAwarded == 0 (antes esta
          // ausencia era una compuerta de escape que permitía cualquier score arbitrario). Si
          // scoreAwarded se omite (al revertir la tarea) no se verifica.
          (
            !request.resource.data.keys().hasAll(['scoreAwarded']) ||
            request.resource.data.scoreAwarded == resource.data.get('puntajeImportancia', 0)
          ) &&
          // Anti-fraude de ranking (2/2): un asignado solo puede atribuirse a SÍ MISMO la
          // finalización (y por ende el score). No puede acreditar la tarea a un tercero. Se
          // permite conservar un completedBy previo (idempotencia) y, al revertir, el campo se
          // elimina por lo que no aparece en keys() y la verificación se omite.
          (
            !request.resource.data.keys().hasAll(['completedBy']) ||
            request.resource.data.completedBy == request.auth.uid ||
            request.resource.data.completedBy == resource.data.get('completedBy', '')
          )
        )
      );
      allow delete: if request.auth != null &&
        hasRole('maestro');
    }

    match /activity_log/{entryId} {
      // Institutional members can read activity logs for performance rankings.
      // Entry creation is restricted to the authenticated user's own entries, with
      // basic shape/size validation to prevent log forging with malformed payloads.
      allow read: if isInstitutional();
      allow create: if isInstitutional() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.type is string &&
        request.resource.data.description is string &&
        request.resource.data.description.size() <= 2000;
    }

    match /files/{fileId} {
      allow read: if isInstitutional();
      allow create: if isInstitutional() && request.resource.data.uploadedBy == request.auth.uid;
      allow delete: if request.auth != null && (
        resource.data.uploadedBy == request.auth.uid ||
        canManageWorkspace()
      );
    }

    match /member_scores/{scoreId} {
      // Users can read their own score; workspace managers, admins, and maestros can read all.
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid || canManageWorkspace());
      allow create, update, delete: if request.auth != null && canManageWorkspace();
    }

    match /events/{eventId} {
      // Institutional members can read calendar events.
      // Creation, updates and deletions are restricted to workspace managers, admins, and maestros.
      allow read: if isInstitutional();
      allow create, update, delete: if request.auth != null && canManageWorkspace();
    }

    match /mail/{mailId} {
      // Only workspace managers/admins/maestros may enqueue mail to prevent spam abuse.
      allow create: if request.auth != null && canManageWorkspace();
    }

    match /mail_digests/{digestId} {
      allow read: if isInstitutional();
      allow create: if request.auth != null && canManageWorkspace();
    }

    match /system_config/{configId} {
      // system_config/keys holds the Drive shared secret, so the institutional-email gate must
      // be airtight. Firestore's matches() is NOT implicitly anchored, so an unanchored pattern
      // like '.*@(sansano[.])?usm[.]cl' also accepts attacker-controlled domains such as
      // 'eve@usm.cl.evil.com' (the regex matches a substring), letting an external user read the
      // secret. Anchor with ^...$ and restrict the local part so only true @usm.cl /
      // @sansano.usm.cl addresses pass. The email claim is also guarded as a string.
      allow read: if isInstitutional();
      allow write: if request.auth != null && (hasRole('maestro') || hasRole('admin'));
    }

    match /posts/{postId} {
      allow read: if isInstitutional();
      allow create: if isInstitutional() &&
        request.resource.data.authorId == request.auth.uid &&
        (!('content' in request.resource.data) ||
          (request.resource.data.content is string && request.resource.data.content.size() <= 10000));
      // The author can edit their own post. Any other authenticated user may ONLY toggle their
      // own like: the previous rule let anyone overwrite likedBy/likesCount with arbitrary
      // values (wipe others' likes, set an arbitrary count). We now require that the only change
      // to likedBy is the caller adding or removing their OWN uid (symmetric difference == {uid})
      // and that likesCount stays consistent with the array length.
      // A content size cap is also enforced on update (not just create) so an author cannot
      // grow their own post unboundedly to abuse storage/egress.
      allow update: if request.auth != null &&
        (!('content' in request.resource.data) ||
          (request.resource.data.content is string && request.resource.data.content.size() <= 10000)) && (
        resource.data.authorId == request.auth.uid ||
        (
          request.resource.data.diff(resource.data).changedKeys().hasOnly(['likedBy', 'likesCount']) &&
          request.resource.data.likedBy is list &&
          request.resource.data.likesCount == request.resource.data.likedBy.size() &&
          resource.data.get('likedBy', []).toSet().difference(request.resource.data.likedBy.toSet())
            .union(request.resource.data.likedBy.toSet().difference(resource.data.get('likedBy', []).toSet()))
            == [request.auth.uid].toSet()
        )
      );
      allow delete: if request.auth != null && (
        resource.data.authorId == request.auth.uid || hasRole('maestro') || hasRole('admin')
      );
    }

    match /comments/{commentId} {
      allow read: if isInstitutional();
      allow create: if isInstitutional() &&
        request.resource.data.authorId == request.auth.uid &&
        (!('content' in request.resource.data) ||
          (request.resource.data.content is string && request.resource.data.content.size() <= 5000));
      allow delete: if request.auth != null && (
        resource.data.authorId == request.auth.uid || hasRole('maestro') || hasRole('admin')
      );
      // Update keeps the same content size cap as create to bound storage/egress abuse.
      allow update: if request.auth != null &&
        (resource.data.authorId == request.auth.uid || hasRole('maestro') || hasRole('admin')) &&
        (!('content' in request.resource.data) ||
          (request.resource.data.content is string && request.resource.data.content.size() <= 5000));
    }

    match /project_messages/{messageId} {
      allow read: if isInstitutional();
      allow create: if isInstitutional() &&
        request.resource.data.senderId == request.auth.uid &&
        (!('content' in request.resource.data) ||
          (request.resource.data.content is string && request.resource.data.content.size() <= 5000));
      allow delete: if request.auth != null && (
        resource.data.senderId == request.auth.uid || hasRole('maestro') || hasRole('admin')
      );
      // Update keeps the same content size cap as create to bound storage/egress abuse.
      allow update: if request.auth != null &&
        (resource.data.senderId == request.auth.uid || hasRole('maestro') || hasRole('admin')) &&
        (!('content' in request.resource.data) ||
          (request.resource.data.content is string && request.resource.data.content.size() <= 5000));
    }
  }
}
